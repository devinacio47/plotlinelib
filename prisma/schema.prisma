// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  author      String
  description String
  coverUrl    String
  genreId     Int
  published   Int?
  genre       Genre     @relation(fields: [genreId], references: [id])
  chapters    Chapter[]
  uploadedAt  DateTime  @default(now())
  country     String?
  status      String?
}

model Chapter {
  id         Int      @id @default(autoincrement())
  number     Int
  title      String?
  contentUrl String
  bookId     Int
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())

  @@index([bookId, uploadedAt(sort: Desc)])
}
